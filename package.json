{
  "name": "tryoncloths",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --env-file-if-exists=.env server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.js --production",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "mobile:sync": "npm run android:sync",
    "android:open": "cap open android",
    "android:debug": "npm run android:sync && node scripts/android-build.mjs assembleDebug",
    "android:sync": "npm run build && cap sync android",
    "android:check": "npm run android:sync && node scripts/android-build.mjs assembleDebug lintDebug",
    "android:assets": "node scripts/mobile-assets.mjs",
    "benchmark:links": "node --env-file-if-exists=.env server/evaluation/link-benchmark.js",
    "evaluate:quality": "node server/evaluation/quality-cli.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@tensorflow/tfjs": "4.22.0",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "@vladmandic/face-api": "1.7.15",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  }
}
