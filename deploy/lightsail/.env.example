# Hostname only, without https://, paths, or a trailing slash.
STUDIO_DOMAIN=api.yourstore.com
ACME_EMAIL=you@yourstore.com
# Server secret: paste the selected provider key only into the instance's ignored .env file.
TRYON_PROVIDER=gemini
TRYON_GEMINI_API_KEY=
TRYON_GEMINI_MODEL=gemini-2.5-flash-image
# Optional alternative; used only when TRYON_PROVIDER=openai.
OPENAI_API_KEY=
# protected requires a store code. public allows anyone to use browser generation
# against your provider quota; the API key remains on the server.
TRYON_ACCESS_MODE=protected
# Separate random store code, at least 24 characters. Leave empty in public mode.
TRYON_MOBILE_TOKEN=
TRYON_OPENAI_MODEL=gpt-image-1.5
TRYON_OPENAI_QUALITY=low
# Change to an immutable release label when deploying an update.
FORME_IMAGE_TAG=local

# Used by compose.accounts.yaml. Set false to close new account registration.
TRYON_ALLOW_SIGNUP=true

# Female library pilot; keep off until live visual review.
TRYON_FEMALE_PROFILES=false

# C5 payments: server only; start with Razorpay test keys. See docs/PAYMENTS.md.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PLAN_STARTER=
# RAZORPAY_PLAN_GROWTH=
# RAZORPAY_PLAN_CHAIN=
# RAZORPAY_PLAN_STARTER_ANNUAL=
# RAZORPAY_PLAN_GROWTH_ANNUAL=
# RAZORPAY_PLAN_CHAIN_ANNUAL=
# FORME_LEGAL_NAME=
# FORME_ADDRESS=
# FORME_BILLING_EMAIL=
# FORME_GSTIN=
# FORME_STATE_CODE=
