# Hostname only, without https://, paths, or a trailing slash.
STUDIO_DOMAIN=api.yourstore.com
ACME_EMAIL=you@yourstore.com
# Server secret: paste the Gemini key only into the instance's ignored .env file.
TRYON_GEMINI_API_KEY=
# Separate random store code, at least 24 characters. Enter this in Android.
TRYON_MOBILE_TOKEN=
TRYON_GEMINI_MODEL=gemini-2.5-flash-image
# Change to an immutable release label when deploying an update.
FORME_IMAGE_TAG=local
