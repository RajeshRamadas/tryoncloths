# Hostname only, without https://, paths, or a trailing slash.
STUDIO_DOMAIN=api.yourstore.com
ACME_EMAIL=you@yourstore.com
# Server secret: paste the OpenAI key only into the instance's ignored .env file.
OPENAI_API_KEY=
# protected requires a store code. public allows anyone to use browser generation
# against your OpenAI quota; the API key remains on the server.
TRYON_ACCESS_MODE=protected
# Separate random store code, at least 24 characters. Leave empty in public mode.
TRYON_MOBILE_TOKEN=
TRYON_OPENAI_MODEL=gpt-image-1.5
TRYON_OPENAI_QUALITY=low
# Change to an immutable release label when deploying an update.
FORME_IMAGE_TAG=local
