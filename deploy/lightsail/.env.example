# Hostname only, without https://, paths, or a trailing slash.
STUDIO_DOMAIN=api.yourstore.com
ACME_EMAIL=you@yourstore.com
# Server secret: paste the selected provider key only into the instance's ignored .env file.
TRYON_PROVIDER=gemini
TRYON_GEMINI_API_KEY=
TRYON_GEMINI_MODEL=gemini-2.5-flash-image
# Optional alternative; used only when TRYON_PROVIDER=openai.
OPENAI_API_KEY=
# protected requires a store code. public allows anyone to use browser generation
# against your provider quota; the API key remains on the server.
TRYON_ACCESS_MODE=protected
# Separate random store code, at least 24 characters. Leave empty in public mode.
TRYON_MOBILE_TOKEN=
TRYON_OPENAI_MODEL=gpt-image-1.5
TRYON_OPENAI_QUALITY=low
# Change to an immutable release label when deploying an update.
FORME_IMAGE_TAG=local

# Used by compose.accounts.yaml. Set false to close new account registration.
TRYON_ALLOW_SIGNUP=true

# Female library pilot; keep off until live visual review.
TRYON_FEMALE_PROFILES=false

# C5 payments: server only; start with Razorpay test keys. See docs/PAYMENTS.md.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PLAN_STARTER=
# RAZORPAY_PLAN_GROWTH=
# RAZORPAY_PLAN_CHAIN=
# RAZORPAY_PLAN_STARTER_ANNUAL=
# RAZORPAY_PLAN_GROWTH_ANNUAL=
# RAZORPAY_PLAN_CHAIN_ANNUAL=
# FORME_LEGAL_NAME=
# FORME_ADDRESS=
# FORME_BILLING_EMAIL=
# FORME_GSTIN=
# FORME_STATE_CODE=

# C11 Shopify/Woo sync (compose.accounts.yaml): reuse the existing persistent
# TRYON_SECRET_KEY from WhatsApp, or generate once with openssl rand -hex 32.
# Do not replace a key already protecting integrations.
# TRYON_SECRET_KEY=
SHOPIFY_API_VERSION=2026-10
SHOPIFY_APP_CLIENT_ID=
SHOPIFY_APP_CLIENT_SECRET=
TRYON_SHOPPER_SESSIONS=false
TRYON_SHOPPER_WORKFLOW=false
# Optional jewellery catalogue foundation. No jewellery generation is exposed yet.
TRYON_JEWELLERY=0
# J2 helper threshold; actual generation integration and pilot calibration remain pending.
TRYON_IDENTITY_MAX=0.45
# Optional compose.shopper-services.yaml mount; see docs/SHOPPER_LAUNCH.md.
# TRYON_SHOPPER_CONFIG_DIR=/home/ubuntu/forme-shopper-services
# TRYON_SHOPPER_CAPTCHA=turnstile
# TRYON_TURNSTILE_SITE_KEY=
# TRYON_TURNSTILE_SECRET_KEY=
# Optional reviewed Gemini safety adapter; uses the existing image key by default.
# TRYON_SHOPPER_MODERATION=gemini
# TRYON_SHOPPER_MODERATION_MODEL=gemini-2.5-flash-lite
# TRYON_SHOPPER_MODERATION_API_KEY=
# Direct trusted Caddy peer/subnet only, required when sessions use one proxy hop.
# TRYON_SHOPPER_PROXY_CIDRS=172.18.0.0/16
# TRYON_SHOPPER_CONSENT_REVISION=
