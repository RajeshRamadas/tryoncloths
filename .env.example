# Required for actual customer avatar generation; server-only, never put in the APK.
# Without this key, only sample browsing/export in sessions without photos is available.
TRYON_PROVIDER=gemini
TRYON_GEMINI_API_KEY=
TRYON_GEMINI_MODEL=gemini-2.5-flash-image
# Optional alternative; used only when TRYON_PROVIDER=openai.
OPENAI_API_KEY=
TRYON_OPENAI_MODEL=gpt-image-1.5
TRYON_OPENAI_QUALITY=low
PORT=3001
# Optional, server-only. Required before enabling connections from installed mobile apps.
# Generate a random value of at least 24 characters; enter it in the app at runtime.
TRYON_MOBILE_TOKEN=

# Optional local web accounts (Node 24+). Keep this directory out of Git.
# TRYON_DATA_DIR=.forme-data
# TRYON_ALLOW_SIGNUP=true

# Female library pilot; keep off until live visual review.
TRYON_FEMALE_PROFILES=false

# Optional reader lives in a separate restricted container; see docs/BROWSER_LINK_READER.md.
# TRYON_LINK_BROWSER=1
# TRYON_READER_URL=http://link-reader:3002
# TRYON_READER_TOKEN=use-a-separate-random-token-at-least-32-characters

# Staff invitations (server only). Use your HTTPS studio origin, SMTP credentials
# from your mail provider, and a verified From address. Never put these in VITE_.
# TRYON_PUBLIC_URL=https://studio.example.com
# SMTP_URL=smtps://username:password@mail.example.com:465
# SMTP_FROM=Forme <staff@example.com>
