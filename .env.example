# Required for actual customer avatar generation; server-only, never put in the APK.
# Without this key, only sample browsing/export in sessions without photos is available.
TRYON_PROVIDER=gemini
TRYON_GEMINI_API_KEY=
TRYON_GEMINI_MODEL=gemini-2.5-flash-image
# Optional alternative; used only when TRYON_PROVIDER=openai.
OPENAI_API_KEY=
TRYON_OPENAI_MODEL=gpt-image-1.5
TRYON_OPENAI_QUALITY=low
PORT=3001
# Optional, server-only. Required before enabling connections from installed mobile apps.
# Generate a random value of at least 24 characters; enter it in the app at runtime.
TRYON_MOBILE_TOKEN=

# Optional local web accounts (Node 24+). Keep this directory out of Git.
# TRYON_DATA_DIR=.forme-data
# TRYON_ALLOW_SIGNUP=true

# Female library pilot; keep off until live visual review.
TRYON_FEMALE_PROFILES=false

# Optional reader lives in a separate restricted container; see docs/BROWSER_LINK_READER.md.
# TRYON_LINK_BROWSER=1
# TRYON_READER_URL=http://link-reader:3002
# TRYON_READER_TOKEN=use-a-separate-random-token-at-least-32-characters

# Staff invitations (server only). Use your HTTPS studio origin, SMTP credentials
# from your mail provider, and a verified From address. Never put these in VITE_.
# TRYON_PUBLIC_URL=https://studio.example.com
# SMTP_URL=smtps://username:password@mail.example.com:465
# SMTP_FROM=Forme <staff@example.com>

# Initial one-time AI grant for pilot organisations; server-only, never VITE_.
# Changing this does not refill existing organisations.
TRYON_PILOT_CREDITS=1000

# C5 payments: server only; start with Razorpay test keys. See docs/PAYMENTS.md.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PLAN_STARTER=
# RAZORPAY_PLAN_GROWTH=
# RAZORPAY_PLAN_CHAIN=
# RAZORPAY_PLAN_STARTER_ANNUAL=
# RAZORPAY_PLAN_GROWTH_ANNUAL=
# RAZORPAY_PLAN_CHAIN_ANNUAL=
# FORME_LEGAL_NAME=
# FORME_ADDRESS=
# FORME_BILLING_EMAIL=
# FORME_GSTIN=
# FORME_STATE_CODE=

# WhatsApp Cloud API (Growth/Chain; pilot/trial available for testing).
# Generate a persistent encryption key with: openssl rand -hex 32
# Keep these server-side. Never use VITE_ variables or commit actual values.
TRYON_SECRET_KEY=
# Shopify/WooCommerce catalogue sync uses the same persistent encryption key.
# Shopify's quarterly Admin GraphQL version; review before its support expires.
SHOPIFY_API_VERSION=2026-10
# Optional C16.2 Shopify app installation and signed setup previews.
# Use a separate app client id/secret; catalogue read-only credentials stay separate.
SHOPIFY_APP_CLIENT_ID=
SHOPIFY_APP_CLIENT_SECRET=
# Absolute directory on tmpfs, excluded from account backups. Docker override:
# deploy/lightsail/compose.shopify.yaml mounts /run/forme-shopper for uid 1000.
# TRYON_SHOPPER_STATE_DIR=/run/forme-shopper
# C16.3 session preview only; image-generation routes are still unavailable.
TRYON_SHOPPER_SESSIONS=false
# With TRYON_TRUST_PROXY_HOPS=1, list only the direct Caddy proxy's CIDRs.
# TRYON_SHOPPER_PROXY_CIDRS=172.18.0.0/16
# Public version id of reviewed shopper photo-consent wording, not a credential.
# CAPTCHA/moderation adapters must also be configured in server code before checks work.
# TRYON_SHOPPER_CONSENT_REVISION=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
